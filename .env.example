JEICHAT_BOT_TOKEN=jei_live_your_token_here
# Nest API (REST + Socket.IO gateway) — same as NEXT_PUBLIC_API_URL / PORT in jeichat
JEICHAT_API_URL=http://localhost:3002
# Fewer startup/thread API calls (optional)
# On bot restart, do not spam kickoff messages on every assigned ticket (default).
# CODE_BOT_ASSIGN_BACKFILL=1
# CODE_BOT_SKIP_PLANNING_KICKOFF=1
# CODE_BOT_SKIP_CHANNEL_EVENTS=1
# Next.js app — used for ticket links in agent prompts
JEICHAT_WEB_ORIGIN=http://localhost:3001

# Cursor Dashboard → Integrations
CURSOR_API_KEY=cursor_your_key_here
CURSOR_RUNTIME=cloud
# Repo comes from the ticket board's GitHub link (Channel settings → GitHub).
# Optional dev fallback when the board has no link yet:
# CURSOR_REPO_URL=https://github.com/org/repo
CURSOR_REPO_REF=develop
CURSOR_MODEL=composer-2.5
# Composer cloud default is the *fast* variant unless you set fast=false (code bot does this automatically).
# CURSOR_MODEL_FAST=1
# Bot waits on run.wait() only (recommended). Set CURSOR_RUN_STREAM=1 to also consume SSE (can cause stream_unavailable).
# CURSOR_RUN_WAIT_ATTEMPTS=4
# CURSOR_CLOUD_ENVIRONMENT=jpmadrigal07/jeichat
# Optional monorepo paths to nudge planning search (comma-separated)
# PLANNING_REPO_HINTS=apps/web,packages/ui
# Thread images forwarded to Cursor planning/draft (presigned URL or inline base64)
# PLANNING_MAX_IMAGES=5
# PLANNING_IMAGE_MAX_BYTES=4194304
# Cloud agents cannot fetch localhost presigned URLs — images are inlined as base64 when CURSOR_RUNTIME=cloud

# Planning session ids (per ticket channel). Uses Upstash when set; otherwise in-process Map.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# PLANNING_AGENT_TTL_SECONDS=604800

# Optional read-only context for resume seeding / debugging (no domain in Coolify)
# PLAN_HTTP_PORT=3102
# PLAN_HTTP_SECRET=change-me

# Post-build verification (from jeichat-reviewer-bot): tests, browser checks, PNG screenshots in thread
# CODE_VERIFY_AFTER_BUILD=true
# CODE_BUILD_WAIT_TIMEOUT_MS=2700000
# REVIEWER_POST_SCREENSHOTS=true
# REVIEWER_MAX_SCREENSHOTS=5
# REVIEWER_LIGHT_VERIFY=true
# REVIEWER_RUN_TIMEOUT_MS=1200000
# Optional: GitHub token for private repos when resolving PR head refs
# GITHUB_TOKEN=
# UI test login: put test email/password in the ticket description (verify agents read the spec). Other secrets stay in Cursor Cloud Environment.
# Verify prompts: dev stack URLs for the *target app* (defaults: JEICHAT_WEB_ORIGIN + JEICHAT_API_URL above)
# VERIFY_APP_WEB_ORIGIN=http://localhost:3001
# VERIFY_APP_API_ORIGIN=http://localhost:3002
# Optional same boot prelude on every verify (pipe-separated or newlines):
# VERIFY_GLOBAL_BOOT_COMMANDS=bun install|turbo build --filter=web
# VERIFY_BOOT_PACKAGES=apps/web,apps/api
# VERIFY_GLOBAL_BOOT=1
# VERIFY_GLOBAL_BOOT_OFF=1
# GITHUB_TOKEN — optional .jeichat/verify-boot.json in the app repo (overrides env when present on branch)
