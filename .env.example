JEICHAT_BOT_TOKEN=jei_live_your_token_here
# Nest API (REST + Socket.IO gateway) — same as NEXT_PUBLIC_API_URL / PORT in jeichat
JEICHAT_API_URL=http://localhost:3002
# Next.js app — used for ticket links in agent prompts
JEICHAT_WEB_ORIGIN=http://localhost:3001

# Cursor Dashboard → Integrations
CURSOR_API_KEY=cursor_your_key_here
CURSOR_RUNTIME=cloud
# Repo comes from the ticket board's GitHub link (Channel settings → GitHub).
# Optional dev fallback when the board has no link yet:
# CURSOR_REPO_URL=https://github.com/org/repo
CURSOR_REPO_REF=develop
CURSOR_MODEL=composer-2.5
# CURSOR_CLOUD_ENVIRONMENT=jpmadrigal07/jeichat
# Optional monorepo paths to nudge planning search (comma-separated)
# PLANNING_REPO_HINTS=apps/web,packages/ui
# Thread images forwarded to Cursor planning/draft (presigned URL or inline base64)
# PLANNING_MAX_IMAGES=5
# PLANNING_IMAGE_MAX_BYTES=4194304
# Cloud agents cannot fetch localhost presigned URLs — images are inlined as base64 when CURSOR_RUNTIME=cloud

# Planning session ids (per ticket channel). Uses Upstash when set; otherwise in-process Map.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# PLANNING_AGENT_TTL_SECONDS=604800

# Optional read-only context for resume seeding / debugging (no domain in Coolify)
# PLAN_HTTP_PORT=3102
# PLAN_HTTP_SECRET=change-me
